# ── Server ────────────────────────────────────────────────
PORT=5001
# Use the Vite dev origin, or * for anything
ALLOWED_ORIGIN=http://localhost:5173

# ── SMTP (real sending) ──────────────────────────────────
# Gmail example: smtp.gmail.com, port 587, secure=false
# (you must enable 2FA + create an App Password, then put it here)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# ── From address shown to recipients ─────────────────────
FROM_NAME=Email Dispatcher
FROM_EMAIL=you@gmail.com

# ── Dispatcher behaviour ─────────────────────────────────
# Retries DONE before giving up (1 initial attempt + this many retries)
RETRY_LIMIT=3
# Wait between retry attempts (ms)
RETRY_DELAY_MS=3000
# Wait between emails (ms)
INTER_EMAIL_DELAY_MS=1200

# ── Demo mode ────────────────────────────────────────────
# When true, no SMTP is used — sends "succeed" instantly.
# Lets you run the full queue/retry demo with no email account.
SMTP_DRYRUN=false